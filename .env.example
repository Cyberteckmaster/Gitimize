# Database
DATABASE_URL="file:./dev.db"

# GitHub (optional, for higher rate limits)
GITHUB_TOKEN=""

# LLM Providers (at least one required for enhanced features)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Hugging Face (for render cloud)
HF_TOKEN=""

# Stripe (for PRO features)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Feature flags
ENABLE_RENDER_CLOUD="true"
ENABLE_COMPETITOR_RADAR="true"
ENABLE_PRO_FEATURES="false"