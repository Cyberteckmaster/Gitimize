generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String    @id @default(cuid())
  repoUrl       String    @unique
  repoName      String
  owner         String
  description   String?
  stars         Int       @default(0)
  forks         Int       @default(0)
  language      String?
  topics        String[]
  defaultBranch String    @default("main")
  license       String?
  homepage      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSyncedAt  DateTime?
  
  jobs          Job[]
  audits        Audit[]
  optimizations Optimization[]
  demos         Demo[]
  renders       Render[]
  upgrades      Upgrade[]
  
  @@index([owner])
  @@index([language])
}

model Job {
  id          String   @id @default(cuid())
  type        JobType
  status      JobStatus @default(PENDING)
  stage       String?
  progress    Int      @default(0)
  input       Json
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([projectId])
  @@index([status])
  @@index([type])
}

enum JobType {
  SHIP
  AUDIT
  OPTIMIZE
  DEMO
  RENDER
  UPGRADE
  SCHEDULED_AUDIT
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Audit {
  id            String   @id @default(cuid())
  score         Int      @default(0)
  grade         Grade
  checks        Json
  summary       Json
  fixes         Json
  strictness    Strictness @default(BALANCED)
  source        Source   @default(LIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([projectId])
  @@index([score])
  @@index([grade])
}

enum Grade {
  S
  A
  B
  C
  D
  F
}

enum Strictness {
  LENIENT
  BALANCED
  STRICT
}

enum Source {
  LIVE
  SNAPSHOT
}

model Optimization {
  id              String   @id @default(cuid())
  seoScore        Int      @default(0)
  aeoScore        Int      @default(0)
  geoScore        Int      @default(0)
  overallScore    Int      @default(0)
  pack            Json
  recommendations Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([projectId])
  @@index([overallScore])
}

model Demo {
  id              String   @id @default(cuid())
  targetSeconds   Int      @default(300)
  style           DemoStyle @default(LAUNCH)
  script          Json
  scenes          Json
  voiceover       String?
  captions        Json?
  webmUrl         String?
  renderCloudId   String?
  status          DemoStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([projectId])
  @@index([status])
}

enum DemoStyle {
  LAUNCH
  TECHNICAL
  STORY
  MINIMAL
}

enum DemoStatus {
  PENDING
  GENERATING_SCRIPT
  GENERATING_SCENES
  RENDERING
  COMPLETED
  FAILED
}

model Render {
  id              String      @id @default(cuid())
  format          RenderFormat @default(WEB_M)
  resolution      RenderResolution @default(HD_1080P)
  fps             Int         @default(30)
  duration        Int
  gpuSecondsUsed  Int         @default(0)
  status          RenderStatus @default(PENDING)
  bundleUrl       String?
  error           String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?
  
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  demoId          String?     @unique
  demo            Demo?       @relation(fields: [demoId], references: [id], onDelete: SetNull)
  
  @@index([projectId])
  @@index([status])
}

enum RenderFormat {
  WEB_M
  MP4
  GIF
  ZIP_BUNDLE
}

enum RenderResolution {
  HD_720P
  HD_1080P
  UHD_4K
}

enum RenderStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Upgrade {
  id              String   @id @default(cuid())
  originalReadme  String
  upgradedReadme  String
  changes         Json
  scoreBefore     Int
  scoreAfter      Int
  categories      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([projectId])
}

model QuotaLedger {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  gpuSecondsUsed  Int      @default(0)
  gpuSecondsLimit Int      @default(300)
  cpuSecondsUsed  Int      @default(0)
  rendersCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([date])
  @@index([date])
}

model ProLicense {
  id              String      @id @default(cuid())
  tier            ProTier     @default(FREE)
  stripeCustomerId String?
  stripeSubId     String?
  status          LicenseStatus @default(ACTIVE)
  seats           Int         @default(1)
  usedSeats       Int         @default(0)
  apiKeys         ApiKey[]
  scheduledAudits ScheduledAudit[]
  currentPeriodEnd DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([stripeCustomerId])
  @@index([status])
}

enum ProTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum LicenseStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @unique
  keyPrefix   String
  permissions String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  proLicenseId String
  proLicense   ProLicense @relation(fields: [proLicenseId], references: [id], onDelete: Cascade)
  
  @@index([proLicenseId])
  @@index([keyHash])
}

model ScheduledAudit {
  id              String   @id @default(cuid())
  cronExpression  String
  strictness      Strictness @default(BALANCED)
  enabled         Boolean  @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  proLicenseId    String
  proLicense      ProLicense @relation(fields: [proLicenseId], references: [id], onDelete: Cascade)
  
  @@index([proLicenseId])
  @@index([nextRunAt])
}

model Feedback {
  id          String   @id @default(cuid())
  type        FeedbackType
  targetId    String
  helpful     Boolean
  comment     String?
  createdAt   DateTime @default(now())
  
  @@index([type, targetId])
  @@index([helpful])
}

enum FeedbackType {
  FIX
  AUDIT
  OPTIMIZATION
  DEMO
  UPGRADE
}